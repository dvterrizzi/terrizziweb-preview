---
title: "Terrizzi – Rockband | Optredens, video’s en boekingen"
bodyClass: is-preload
navKey: home
permalink: index.html
---
{% extends "base.njk" %}
{% from "macros.njk" import upcomingTable, promoVideo %}

{% block head %}
	<style>
		/* Mobile/tablet portrait: 9x16 keeps all band members in frame */
		#wrapper > .bg {
			background-image: url('images/overlay.png'), linear-gradient(0deg, rgba(0,0,0,0.1), rgba(0,0,0,0.1)), url('assets/img/band/IMG_2481_9x16_BW_web.jpg') !important;
			background-size: auto, auto, cover !important;
			background-position: center, center, center !important;
		}
		/* Desktop: switch to 16x9 when the nav bar appears (matches '>medium' breakpoint) */
		@media (min-width: 981px) {
			#wrapper > .bg {
				background-image: url('images/overlay.png'), linear-gradient(0deg, rgba(0,0,0,0.1), rgba(0,0,0,0.1)), url('assets/img/band/IMG_2481_16x9_BW_web.jpg') !important;
			}
		}
	</style>
{% endblock %}

{% block intro %}
		<!-- Intro -->
		<section id="intro">
			<h1><img src="assets/img/logo/Terrizzi_Logo_White_TranspV2.png" alt="{{ site.name }}" class="intro-logo" /></h1>
			<ul class="actions special">
				<li><a href="live.html" class="button primary large">Optredens</a></li>
				<li><a href="media.html" class="button large">Bekijk &amp; Luister</a></li>
			</ul>
		</section>
{% endblock %}

{% block main %}
			<!-- Bio + promo video -->
			<article class="post featured">
				<div class="promo-split">
					<div class="promo-bio">
						<p>{{ site.bio }}</p>
					</div>
					{{ promoVideo(site) }}
				</div>
			</article>

			<!-- Upcoming Shows (full width) -->
			<article class="post featured">
				<header class="major">
					<h2><a href="live.html">Aankomende optredens</a></h2>
				</header>
				{{ upcomingTable(gigs.upcoming) }}
				<ul class="actions special">
					<li><a href="live.html" class="button large">Alle data</a></li>
				</ul>
			</article>
{% endblock %}
