<html>

<head>
	<title>{{ title }}</title>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<link rel="stylesheet" href="assets/css/main.css" />
	<link rel="stylesheet" href="assets/css/terrizzi.css" />
	<noscript><link rel="stylesheet" href="assets/css/noscript.css" /></noscript>
	<link rel="icon" type="image/png" href="assets/img/logo/Terrizzi_Icon_WhiteV2.png" />
	{%- block head %}{% endblock %}
</head>

<body class="{{ bodyClass }}">

	<div id="wrapper">

		{%- block intro %}{% endblock %}

		<!-- Header -->
		<header id="header">
			<a href="index.html" class="logo"><img src="assets/img/logo/Terrizzi_White.png" alt="{{ site.name }}" /></a>
		</header>

		<!-- Nav -->
		<nav id="nav">
			<ul class="links">
				{%- for item in site.nav %}
				<li{% if item.key == navKey %} class="active"{% endif %}><a href="{{ item.url }}">{{ item.title }}</a></li>
				{%- endfor %}
			</ul>
			<ul class="icons">
				{%- for s in site.social %}
				<li><a href="{{ s.url }}" target="_blank" rel="noopener noreferrer" class="icon brands {{ s.icon }}"><span class="label">{{ s.name }}</span></a></li>
				{%- endfor %}
			</ul>
		</nav>

		<!-- Main -->
		<div id="main">
			{% block main %}{% endblock %}
		</div>

		<!-- Footer -->
		<footer id="footer">
			<section>
				<img src="assets/img/logo/Terrizzi_Icon_WhiteV2.png" alt="{{ site.name }}" class="logo-stamp" />
				<ul class="icons alt">
					{%- for s in site.social %}
					<li><a href="{{ s.url }}" target="_blank" rel="noopener noreferrer" class="icon brands alt {{ s.icon }}"><span class="label">{{ s.name }}</span></a></li>
					{%- endfor %}
				</ul>
			</section>
		</footer>

		<!-- Copyright -->
		<div id="copyright">
			<ul>
				<li>&copy; {{ site.name }} {{ year }}</li>
				<li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
				<li>Design: {{ site.name }} / <a href="https://html5up.net">HTML5 UP</a></li>
			</ul>
		</div>

	</div>

	<!-- Scripts -->
	<script src="assets/js/jquery.min.js"></script>
	<script src="assets/js/jquery.scrollex.min.js"></script>
	<script src="assets/js/jquery.scrolly.min.js"></script>
	<script src="assets/js/browser.min.js"></script>
	<script src="assets/js/breakpoints.min.js"></script>
	<script src="assets/js/util.js"></script>
	<script src="assets/js/main.js"></script>

</body>

</html>
